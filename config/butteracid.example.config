# Copy to butteracid.local.config and replace each placeholder path.
# Use literal Bash-style values; the R parser does not expand shell variables.
MODE="unicorn"
LIBRARY_LIST="/path/to/run/samples.list"
QC_OUTPUT="/path/to/run/QC_stats.tsv"
FASTQ_LANE_BASE="/path/to/fastq"
FASTQ_LOW_COMPLEXITY_BASE="/path/to/run"
FASTQ_PREFILTER_BASE="/path/to/run/eukaryotic"
BAM_BASE="/path/to/run/microbial"
PREFILTER_BAM_BASE="/path/to/run/eukaryotic"
FASTP_REPORT_BASE="/path/to/run/logs"
FASTP_REPORT_PATTERN="*.fastp.report.html"
SCRATCH_DIR="/path/to/run/tmp"
LOG_FILE="/path/to/run/butteracid.log"
TAX_PATH_NCBI="/path/to/ncbi/taxonomy"
EUK_DIR="/path/to/run/eukaryotic"
