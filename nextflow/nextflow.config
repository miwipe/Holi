manifest {
    name = 'miwipe/Holi'
    description = 'Alternative eight-stage Holi runner (experimental)'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10.2'
}
params {
    input = null
    settings = null
    references = null
    outdir = 'results/holi-nextflow'
    cpus = 4
    memory = '16 GB'
    max_forks = 1
    help = false
}
process {
    executor = 'local'
    cpus = params.cpus
    memory = params.memory
    maxForks = params.max_forks
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
}
profiles {
    slurm {
        process.executor = 'slurm'
        // Supply site-specific queue, account and resource limits with -c.
    }
}
// Keep every invocation, including resume, as a separate execution record.
trace { enabled = true; file = "${params.outdir}/execution/${new Date().format('yyyyMMdd-HHmmss-SSS')}/trace.tsv" }
report { enabled = true; file = "${params.outdir}/execution/${new Date().format('yyyyMMdd-HHmmss-SSS')}/report.html" }
timeline { enabled = true; file = "${params.outdir}/execution/${new Date().format('yyyyMMdd-HHmmss-SSS')}/timeline.html" }
